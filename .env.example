# LLM Proxy URL (Supabase Edge Function)
# When set, all LLM API calls route through this proxy (eliminates CORS issues).
# When empty, Claude falls back to direct browser→Anthropic calls (dev only).
VITE_LLM_PROXY_URL=https://YOUR_PROJECT.supabase.co/functions/v1/llm-proxy

# RTP Community Model URL (Tier 1 — free, no API key)
# Override this to point at your own vLLM instance.
VITE_RTP_MODEL_URL=https://api.relationaltech.org

# Canonical site URL — where magic-link sign-in should land builders.
# Set this in production so a sign-in from any origin (e.g. a *.vercel.app
# preview) returns to the real domain. Unset = use the current origin (dev).
# Must ALSO be listed in Supabase Auth → URL Configuration → Redirect URLs.
VITE_SITE_URL=https://relationalbuilder.org

# Builder cloud backend (accounts, cloud projects, collaboration)
# A DEDICATED Supabase project — not the RTS Studio knowledge base.
# Leave unset to run in local-only mode (localStorage).
VITE_BUILDER_SUPABASE_URL=https://YOUR_BUILDER_PROJECT.supabase.co
VITE_BUILDER_SUPABASE_ANON_KEY=your-builder-anon-key
