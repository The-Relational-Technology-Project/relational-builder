{
  "rewrites": [
    {
      "source": "/s/:path(.*)",
      "destination": "/api/site?path=:path"
    },
    {
      "source": "/b/:path(.*)",
      "destination": "/api/site?path=:path&b=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/commons",
      "destination": "/api/commons?path="
    },
    {
      "source": "/commons/:path(.*)",
      "destination": "/api/commons?path=:path"
    },
    {
      "source": "/connect/respond",
      "destination": "/api/connect"
    },
    {
      "source": "/steward/respond",
      "destination": "/api/steward-respond"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
